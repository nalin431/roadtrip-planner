# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- frontend (Next.js) ---
frontend/node_modules
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage
frontend/.next/
frontend/out/
frontend/build
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel

# --- backend (Go) ---
backend/tmp/
backend/bin/
backend/*.exe
backend/*.test
backend/coverage.out

# --- infra (CDK) ---
infra/node_modules
infra/cdk.out/
infra/*.d.ts
infra/*.js
!infra/jest.config.js

# --- misc ---
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
**/.env
**/.env.local

# IDE
.vscode/
.idea/
