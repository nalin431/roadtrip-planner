APP_ENV=local
PORT=8000

# Transaction-mode pooler connection string (port 6543) -- see
# app/db/session.py and ARCHITECTURE.md for why. Used at runtime.
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# Session-mode pooler connection string (port 5432) -- migrations need a
# persistent session, which transaction mode doesn't provide.
DATABASE_URL_MIGRATE=postgresql+asyncpg://user:password@host:5432/postgres

ALLOWED_ORIGIN=http://localhost:3000

# Server-side only -- never exposed to the browser. Should be a key
# restricted separately from any browser-facing Google Maps key.
GOOGLE_PLACES_API_KEY=
