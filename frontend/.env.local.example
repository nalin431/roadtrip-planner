# Browser-exposed (NEXT_PUBLIC_*) -- fine for Maps JS SDK usage, but keep
# this key restricted (HTTP referrer) and separate from any server-side key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# FastAPI backend base URL. Local dev default shown; set to the deployed
# API Gateway URL in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Used for OG image absolute URL resolution. Set to the deployed Vercel URL
# in production; local dev default shown.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
